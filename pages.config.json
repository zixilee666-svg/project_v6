{
  "$schema": "https://edgeone.ai/schemas/pages-config.json",
  "version": 2,
  "edgeFunctions": {
    "dir": "./edge-functions"
  },
  "cloudFunctions": {
    "dir": "./cloud-functions"
  },
  "routes": [
    {
      "path": "/api/auth/*",
      "target": "./edge-functions/api/auth"
    },
    {
      "path": "/api/papers/*",
      "target": "./edge-functions/api/papers"
    },
    {
      "path": "/api/projects/*",
      "target": "./edge-functions/api/projects"
    },
    {
      "path": "/api/libraries/*",
      "target": "./edge-functions/api/libraries"
    },
    {
      "path": "/api/materials/*",
      "target": "./edge-functions/api/materials"
    },
    {
      "path": "/api/chats/*",
      "target": "./edge-functions/api/chats"
    },
    {
      "path": "/api/spaces/*",
      "target": "./edge-functions/api/spaces"
    },
    {
      "path": "/api/admin/*",
      "target": "./edge-functions/api/admin"
    },
    {
      "path": "/api/settings/*",
      "target": "./edge-functions/api/settings"
    },
    {
      "path": "/api/stats/*",
      "target": "./edge-functions/api/stats"
    },
    {
      "path": "/api/search/*",
      "target": "./edge-functions/api/search"
    },
    {
      "path": "/api/ai/*",
      "target": "./cloud-functions/api"
    },
    {
      "path": "/*",
      "target": "./dist"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "./dist",
  "env": {
    "JWT_SECRET": {
      "description": "JWT signing secret (min 32 characters)",
      "value": "academic-hub-v4-jwt-secret-key-2026"
    },
    "JWT_EXPIRES_IN": {
      "description": "JWT token expiration time",
      "value": "7d"
    },
    "ADMIN_USERNAME": {
      "description": "Admin login username",
      "value": "admin"
    },
    "ADMIN_PASSWORD": {
      "description": "Admin login password",
      "value": "123456"
    },
    "AI_API_KEY": {
      "description": "OpenAI API key for AI chat (leave empty for mock mode)",
      "value": ""
    },
    "AI_API_URL": {
      "description": "AI API endpoint URL",
      "value": "https://api.openai.com/v1/chat/completions"
    },
    "CORS_ORIGINS": {
      "description": "Allowed CORS origins (comma-separated, or * for all)",
      "value": "*"
    }
  }
}
